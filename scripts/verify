#!/usr/bin/env bash
# Jediná brána „hotovo“: Python (ruff, pytest) + JS (ESLint, Prettier, node --test).
# Na obrazovku jen souhrn; plné výstupy v .verify-logs/. Exit 0 = vše prošlo.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 2

LOG_DIR=.verify-logs
rm -rf "$LOG_DIR" && mkdir -p "$LOG_DIR"
failed=0

run() {
  local name=$1
  shift
  local log="$LOG_DIR/$name.log"
  if "$@" >"$log" 2>&1; then
    printf '✓ %s\n' "$name"
  else
    printf '✗ %s  (celý výstup: %s)\n' "$name" "$log"
    tail -n 20 "$log" | sed 's/^/    /'
    failed=1
  fi
}

run uv-sync uv sync --frozen --quiet
run ruff-check uv run --frozen ruff check .
run ruff-format uv run --frozen ruff format --check .
run pytest uv run --frozen pytest -q

if [ ! -d node_modules ]; then
  run npm-ci npm ci --silent --no-audit --no-fund
fi
run eslint npx --no-install eslint --max-warnings 0 .
run prettier npx --no-install prettier --check 'krizky_map/assets/**/*.{js,css}'
if compgen -G 'tests/js/*.test.mjs' >/dev/null; then
  run node-test node --test 'tests/js/*.test.mjs'
fi

exit "$failed"
